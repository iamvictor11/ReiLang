echo "-- midi --";
program "MusicBox";
song := [
    .6,  .7, \ .1^, .7, .1^, .3^, \ .7, .0,  .3, \ .6,  .5,  .6,  .1^,
    .5, .0, .4, .3, \ .4, .3, .4, .1^, \ .3, .0, .1^, .1^, .1^, \ .7, .4#, .4#, .7,
    .7, .0, .6, .7, \ .1^, .7, .1^, .3^, \ .7, .0, .3, .3, \ .6, .5, .6, .1^,
    .5, .0, .3, \ .4, .1^, .7, .1^, \ .2^, .3^, .1^, \ .1^, .7, .6, .7, .5#,
    .6, .1^, .2^, \ .3^, .2^, .3^, .5^, \ .2^, .0, .5, .5, \ .1^, .7, .1^, .3^,
    .3, .0, \ .6, .7, .1^, .7, .1^, .2^, \ .1^, .5, .5, \ .4^, .3^, .2^, .1^,
    .3^, .3^, \ .6^, .5^, \ .3^, .2^, .1^,
    .2^, .1^, .2^, .5^, \ .3^, .3^, \ .6^, .5^, \ .3^, .2^, .1^,
    .2^, .1^, .2^, .7, \ .6, .6, .7, \ .1^, .7, .1^, .3^, \ .7, .0, .3,
    .6, .5, .6, .1^, \ .5, .0, .4, .3, \ .4, .3, .4, .1^, \ .3, .0, .1^, .1^, .1^,
    .7, .4#, .4#, .7, \ .7, .0, .6, .7, \ .1^, .7, .1^, .3^, \ .7, .0, .3, .3,
    .6, .5, .6, .1^, \ .5, .0, .3, \ .4, .1^, .7, .1^, \ .2^, .3^, .1^,
    .1^, .7, .6, .7, .5#, \ .6
];
dur := [
    0.5, 0.5, \ 1.5, 0.5, 1, 1, \ 2, 1, 1, \ 1.5, 0.5, 1, 1,
    2, 1, 0.5, 0.5, \ 1, 1, 1, 1, \ 2, 0.5, 0.5, 0.5, 0.5, \ 1, 1, 1, 1,
    2, 1, 0.5, 0.5, \ 1.5, 0.5, 1, 1, \ 2, 1, 0.5, 0.5, \ 1.5, 0.5, 1, 1,
    2, 1, 1, \ 1, 0.5, 1.5, 1, \ 1, 0.5, 2.5, \ 0.5, 0.5, 1, 1, 1,
    3, 0.5, 0.5, \ 1.5, 0.5, 1, 1, \ 2, 1, 0.5, 0.5, \ 1.5, 0.5, 1, 1,
    3, 1, \ 0.5, 0.5, 1, 0.5, 0.5, 1, \ 1.5, 0.5, 2, \ 1, 1, 1, 1,
    7, 1, \ 2, 2, \ 1, 0.5, 2.5,
    1, 0.5, 1.5, 1, \ 3, 1, \ 2, 2, \ 1, 0.5, 2.5,
    1, 0.5, 1.5, 1, \ 3, 0.5, 0.5, \ 1.5, 0.5, 1, 1, \ 2, 1, 1,
    1.5, 0.5, 1, 1, \ 2, 1, 0.5, 0.5, \ 1.5, 0.5, 1, 1, \ 2, 0.5, 0.5, 0.5, 0.5,
    1.5, 0.5, 1, 1, \ 2, 1, 0.5, 0.5, \ 1.5, 0.5, 1, 1, \ 2, 1, 0.5, 0.5,
    1.5, 0.5, 1, 1, \ 2, 1, 1, \ 1, 0.5, 1.5, 1, \ 1, 0.5, 2.5,
    0.5, 0.5, 1, 1, 1, \ 4
];
i := 0;
count := len(song);
loop i < count
do
    println "i: " + i + " n: " + song[i] + " d: " + dur[i];
    print "ing ";
    play song[i];
    wait dur[i];
    unplay song[i];
    println "end";
    i += 1;
end